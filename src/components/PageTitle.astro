---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import AboutPage from "./AboutPage.astro";
import { collectGuides, loadIntegration, sections } from "../../scripts/lib/documentation.mjs";
import { productEvidence } from "../../scripts/lib/product-evidence.mjs";
import { acceptedEditsFor, pullRequestLabel } from "../../scripts/lib/accepted-edits.mjs";
import { checkedAgainstFor, showCheckedAgainst } from "../../scripts/lib/pinned-releases.mjs";
import notes from "../../migration/source-review-notes.json";

const id = Astro.locals.starlightRoute.entry.id.replace(/\.(md|mdx)$/, "");
const article = loadIntegration().find((item) => item.route === `/${id}/`);
const guide = article ? collectGuides().find((item) => item.slug === article.slug) : undefined;
const section = sections.find((item) => item.directory === guide?.directory);
const products = article ? productEvidence(article) : [];
const edits = article ? acceptedEditsFor(article.slug) : [];
// Validates src/data/pinned-releases.json whether or not the chip is switched on; no evidence, no chip.
const checkedAgainst = article ? checkedAgainstFor(article.slug) : [];
const showChecked = showCheckedAgainst() && checkedAgainst.length > 0;
const checks = article ? notes.items.filter((note) => note.source_slugs.includes(article.slug)).length : 0;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const revisionDate = article?.revision_timestamp ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(article.revision_timestamp)) : "Date not recorded";
---
{article ? <>
  <nav class="article-crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
    <ol><li><a href={`${base}/`}>Docs</a></li>{section && <li><a href={`${base}/browse/${section.directory}/`}>{section.label}</a></li>}</ol>
  </nav>
  <h1 id="_top" lang={article.source_language || undefined}>{article.title}</h1>
  <div class="article-title-context" data-pagefind-ignore>
    <div class="article-meta">
      {/* A chip only where the article names a product; no chip is shown without that evidence. */}
      {products.length > 0 && <span class="product-labels">
        {products.map((product) => <span class="docs-chip product" title={product.basis}><span class="dot" aria-hidden="true"></span>{product.label}</span>)}
      </span>}
      {/* "Checked against": only the release a verified migration check pins (scripts/lib/pinned-releases.mjs), linked to the About this page card: the rail from 72rem up, the row below. */}
      {showChecked && <span class="product-labels checked-labels">
        {checkedAgainst.map((release) => {
          const title = `A migration check compared parts of this article with ${release.label}, not the whole procedure. About this page lists each check and its sources.`;
          return <>
            <a class="docs-chip checked checked-to-rail" href="#docs-about-page-rail" title={title}><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>Checked against {release.label}</a>
            <a class="docs-chip checked checked-to-row" href="#docs-about-page-row" title={title}><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>Checked against {release.label}</a>
          </>;
        })}
      </span>}
      {edits.length ? <span>Edited after restoration: {edits.map((edit, index) => <>{index > 0 && ", "}<a href={edit.pull_request}>{pullRequestLabel(edit.pull_request)}</a></>)}</span> : <span>Original wiki wording</span>}
      <span class="revision-stamp">rev {article.revision_id} · {revisionDate}</span>
      <button type="button" class="docs-icon-button" data-copy-page hidden aria-label="Copy link to this page" title="Copy link to this page"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg></button>
    </div>
    <details class="about-page about-page-row" id={showChecked ? "docs-about-page-row" : undefined}>
      <summary><svg class="disclosure-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg><span class="about-page-row-title">About this page</span>{checks > 0 && <span class="about-page-row-count">{checks} migration {checks === 1 ? "check" : "checks"}</span>}</summary>
      <AboutPage />
    </details>
  </div>
</> : <Default />}
